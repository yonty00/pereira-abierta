# Caddyfile — reverse proxy for PocketBase, with edge blocking + security headers.
# Sanitized example. Caddy listens on :80 behind an outbound-only Cloudflare Tunnel,
# so Cloudflare terminates HTTPS and no ports are opened on the host.
#
# The public API is a single PocketBase collection ("Negocios"); everything else,
# including the admin UI (/_/), is blocked at the edge and returns 404.

:80 {
	# ---- Security headers ----
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(self), camera=(), microphone=()"
		# CSP scoped to exactly what the app loads (map libs, tiles, geocoding,
		# web font, analytics beacon, inline scripts/styles, data: images).
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: blob: https://*.tile.openstreetmap.org https://tile.openstreetmap.org https://unpkg.com; style-src 'self' 'unsafe-inline' https://unpkg.com https://fonts.googleapis.com; script-src 'self' 'unsafe-inline' https://unpkg.com https://static.cloudflareinsights.com; connect-src 'self' https://nominatim.openstreetmap.org https://unpkg.com https://cloudflareinsights.com; font-src 'self' https://fonts.gstatic.com"
		-Server
	}

	# ---- Block admin UI + non-public API paths at the edge ----
	@blocked {
		path /api/* /_ /_/*
		not path /api/collections/Negocios/records /api/collections/Negocios/records/*
	}
	respond @blocked 404

	# ---- Proxy everything else to the local PocketBase instance ----
	reverse_proxy 127.0.0.1:8090
	encode gzip
}
